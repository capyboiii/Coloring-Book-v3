# Sao chép file này thành .env rồi điền giá trị thật.
# .env đã nằm trong .gitignore - KHÔNG commit nó.
# server.py tự nạp .env khi khởi động.

# ---------------------------------------------------------------- Cloudflare R2
R2_ACCOUNT_ID=67c27dbf0811c582405f2871ceefdb8f
R2_ENDPOINT=https://67c27dbf0811c582405f2871ceefdb8f.r2.cloudflarestorage.com
R2_BUCKET=crayonahub

# Tạo ở Cloudflare dashboard: R2 > Manage API Tokens > Create API Token.
# Chọn quyền "Object Read & Write" và GIỚI HẠN vào đúng bucket crayonahub.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Domain công khai đã gắn vào bucket. Dùng cho ẢNH PREVIEW (marketing) - thứ
# vốn để cho người ta xem. KHÔNG dùng cho PDF ruột sách.
R2_PUBLIC_BASE=https://cdn.crayonahub.com

# Prefix trong bucket. Tách riêng để không đụng dữ liệu sẵn có của website.
# QUAN TRỌNG: không viết chú thích trên cùng dòng với giá trị.
# PDF gửi Lulu    -> books/<slug>/print/<sha8>/interior.pdf
R2_PREFIX_PDF=books
# Ảnh preview     -> images/<slug>/preview_1.png
R2_PREFIX_PREVIEW=images

# Hạn của presigned URL cấp cho Lulu. Trần cứng của SigV4 là 7 ngày.
R2_PRESIGN_DAYS=7

# ---------------------------------------------------------------- Gemini
GEMINI_API_KEY=
